# Copy to .env and adjust. Every variable has a sensible default (see bootstrap/settings.py).

APP_NAME=python-clean-architecture-template
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# SQLite file (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# PostgreSQL (docker compose up -d db):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
# No database at all (in-memory adapters, nothing persisted):
# DATABASE_URL=memory://
DATABASE_ECHO=false

# Authentication: empty = disabled (everyone is "anonymous"). JSON map api-key -> actor[:roles].
# API_KEYS={"s3cret": "alice", "adm1n": "root:admin"}
